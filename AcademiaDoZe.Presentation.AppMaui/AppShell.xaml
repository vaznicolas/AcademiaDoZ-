<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AcademiaDoZe.Presentation.AppMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:AcademiaDoZe.Presentation.AppMaui"
    xmlns:views="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Views"
    Title="Academia do Zé">

    <FlyoutItem Title="Dashboard">
        <ShellContent
            ContentTemplate="{DataTemplate views:DashboardListPage}"
            Route="dashboard" />
    </FlyoutItem>
    
    <ShellContent
    Title="Alunos"
    ContentTemplate="{DataTemplate views:AlunoListPage}"
    Route="alunos" />

    <FlyoutItem Title="Logradouros">
        <ShellContent
            ContentTemplate="{DataTemplate views:LogradouroListPage}"
            Route="logradouros" />
    </FlyoutItem>

    <FlyoutItem Title="Colaboradores">
        <ShellContent
        Title="Colaboradores"
        ContentTemplate="{DataTemplate views:ColaboradorListPage}"
        Route="colaboradores" />
    </FlyoutItem>

    <FlyoutItem Title="Configurações" Icon="academiadoze.png">
        <ShellContent
        Title="Configurações"
        ContentTemplate="{DataTemplate views:ConfigPage}"
        Route="ConfigPage" />
    </FlyoutItem>

</Shell>