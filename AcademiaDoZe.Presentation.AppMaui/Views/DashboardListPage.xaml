<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
    x:DataType="vm:DashboardListViewModel"
    Title="{Binding Title}"
    BackgroundColor="{StaticResource OldSchoolBackground}">

    <ScrollView>
        <VerticalStackLayout
        Padding="20"
        Spacing="16">


            <!-- CABECALHO OLD SCHOOL COMPACTO -->

            <Border
    BackgroundColor="#071A47"
    Stroke="#0B2A6F"
    StrokeThickness="2"
    StrokeShape="RoundRectangle 8"
    Padding="18">

                <Grid
        ColumnDefinitions="100,*"
        ColumnSpacing="22"
        MinimumHeightRequest="115">

                    <!-- LOGO -->

                    <Image
            Grid.Column="0"
            Source="academiadoze.png"
            WidthRequest="95"
            HeightRequest="95"
            Aspect="AspectFit"
            VerticalOptions="Center" />

                    <!-- IDENTIDADE -->

                    <VerticalStackLayout
            Grid.Column="1"
            Spacing="8"
            VerticalOptions="Center">

                        <Label
                Text="ACADEMIA DO ZÉ"
                FontFamily="Graduate"
                FontSize="26"
                TextColor="White"
                LineBreakMode="WordWrap" />

                        <Label
                Text="PAINEL ADMINISTRATIVO"
                FontFamily="Oswald"
                FontSize="15"
                CharacterSpacing="2"
                TextColor="White" />

                        <BoxView
                Color="White"
                HeightRequest="2"
                HorizontalOptions="Fill" />

                    </VerticalStackLayout>

                </Grid>

            </Border>


            <!-- TITULO DA SECAO -->

            <VerticalStackLayout Spacing="6">

                <Label
                    Text="VISÃO GERAL"
                    Style="{StaticResource OldSchoolPageTitle}" />

                <Label
                    Text="Indicadores da Academia do Zé"
                    Style="{StaticResource OldSchoolSecondaryText}" />

            </VerticalStackLayout>

            <!-- INDICADORES -->

            <Grid
                ColumnDefinitions="*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="16"
                RowSpacing="16">

                <!-- LOGRADOUROS -->

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="0"
                    BackgroundColor="White"
                    Stroke="{StaticResource OldSchoolPrimary}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 8">

                    <VerticalStackLayout Spacing="0">

                        <Grid
                            BackgroundColor="{StaticResource OldSchoolPrimary}"
                            Padding="16,12">

                            <Label
                                Text="LOGRADOUROS"
                                FontFamily="Oswald"
                                FontSize="16"
                                CharacterSpacing="1"
                                TextColor="White" />

                        </Grid>

                        <Label
                            Text="{Binding TotalLogradouros}"
                            FontFamily="Graduate"
                            FontSize="38"
                            TextColor="{StaticResource OldSchoolPrimary}"
                            HorizontalTextAlignment="Center"
                            Margin="12,20,12,22" />

                    </VerticalStackLayout>
                </Border>

                <!-- ALUNOS -->

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Padding="0"
                    BackgroundColor="White"
                    Stroke="{StaticResource OldSchoolPrimary}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 8">

                    <VerticalStackLayout Spacing="0">

                        <Grid
                            BackgroundColor="{StaticResource OldSchoolPrimary}"
                            Padding="16,12">

                            <Label
                                Text="ALUNOS"
                                FontFamily="Oswald"
                                FontSize="16"
                                CharacterSpacing="1"
                                TextColor="White" />

                        </Grid>

                        <Label
                            Text="{Binding TotalAlunos}"
                            FontFamily="Graduate"
                            FontSize="38"
                            TextColor="{StaticResource OldSchoolPrimary}"
                            HorizontalTextAlignment="Center"
                            Margin="12,20,12,22" />

                    </VerticalStackLayout>
                </Border>

                <!-- COLABORADORES -->

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="0"
                    BackgroundColor="White"
                    Stroke="{StaticResource OldSchoolPrimary}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 8">

                    <VerticalStackLayout Spacing="0">

                        <Grid
                            BackgroundColor="{StaticResource OldSchoolPrimary}"
                            Padding="16,12">

                            <Label
                                Text="COLABORADORES"
                                FontFamily="Oswald"
                                FontSize="16"
                                CharacterSpacing="1"
                                TextColor="White" />

                        </Grid>

                        <Label
                            Text="{Binding TotalColaboradores}"
                            FontFamily="Graduate"
                            FontSize="38"
                            TextColor="{StaticResource OldSchoolPrimary}"
                            HorizontalTextAlignment="Center"
                            Margin="12,20,12,22" />

                    </VerticalStackLayout>
                </Border>

                <!-- MATRICULAS -->

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="0"
                    BackgroundColor="White"
                    Stroke="{StaticResource OldSchoolPrimary}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 8">

                    <VerticalStackLayout Spacing="0">

                        <Grid
                            BackgroundColor="{StaticResource OldSchoolPrimary}"
                            Padding="16,12">

                            <Label
                                Text="MATRÍCULAS"
                                FontFamily="Oswald"
                                FontSize="16"
                                CharacterSpacing="1"
                                TextColor="White" />

                        </Grid>

                        <Label
                            Text="{Binding TotalMatriculas}"
                            FontFamily="Graduate"
                            FontSize="38"
                            TextColor="{StaticResource OldSchoolPrimary}"
                            HorizontalTextAlignment="Center"
                            Margin="12,20,12,22" />

                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- ACESSO RAPIDO EXISTENTE -->


            <!-- ACESSOS RAPIDOS OLD SCHOOL -->

            <VerticalStackLayout Spacing="14">

                <Label
        Text="ACESSO RÁPIDO"
        Style="{StaticResource OldSchoolSubtitle}" />

                <Grid
        ColumnDefinitions="*,*"
        RowDefinitions="Auto,Auto"
        ColumnSpacing="14"
        RowSpacing="14">

                    <!-- ALUNOS -->

                    <Button
            Grid.Row="0"
            Grid.Column="0"
            Text="ALUNOS"
            Command="{Binding NavigateToAlunosCommand}"
            Style="{StaticResource OldSchoolPrimaryButton}"
            HeightRequest="56" />

                    <!-- MATRICULAS -->

                    <Button
            Grid.Row="0"
            Grid.Column="1"
            Text="MATRÍCULAS"
            Command="{Binding NavigateToMatriculasCommand}"
            Style="{StaticResource OldSchoolPrimaryButton}"
            HeightRequest="56" />

                    <!-- CONTROLE DE ACESSO -->

                    <Button
            Grid.Row="1"
            Grid.Column="0"
            Text="CONTROLE DE ACESSO"
            Command="{Binding NavigateToControleAcessoCommand}"
            Style="{StaticResource OldSchoolSecondaryButton}"
            HeightRequest="56" />

                    <!-- LOGRADOUROS -->

                    <Button
            Grid.Row="1"
            Grid.Column="1"
            Text="LOGRADOUROS"
            Command="{Binding NavigateToLogradourosCommand}"
            Style="{StaticResource OldSchoolSecondaryButton}"
            HeightRequest="56" />

                </Grid>

            </VerticalStackLayout>


            <!-- CARREGAMENTO -->

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource OldSchoolPrimary}"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>

