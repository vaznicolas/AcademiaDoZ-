<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.AlunoPage"
    Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label
                Text="Dados pessoais"
                FontSize="22"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Nome completo"
                Text="{Binding Aluno.Nome}" />

            <Entry
                Placeholder="CPF"
                Keyboard="Numeric"
                Text="{Binding Aluno.Cpf}" />

            <Label Text="Data de nascimento" />

            <DatePicker
                Date="{Binding DataNascimentoDateTime, Mode=TwoWay}"
                Format="dd/MM/yyyy" />

            <Entry
                Placeholder="Telefone com DDD"
                Keyboard="Telephone"
                Text="{Binding Aluno.Telefone}" />

            <Entry
                Placeholder="E-mail (opcional)"
                Keyboard="Email"
                Text="{Binding Aluno.Email}" />

            <Label
                Text="Endereço"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,12,0,0" />

            <Entry
                Placeholder="CEP cadastrado em Logradouros"
                Keyboard="Numeric"
                Text="{Binding Aluno.Endereco.Cep}" />

            <Entry
                Placeholder="Número"
                Text="{Binding Aluno.Numero}" />

            <Entry
                Placeholder="Complemento (opcional)"
                Text="{Binding Aluno.Complemento}" />

            <Label
                Text="Senha"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,12,0,0" />

            <Entry
                Placeholder="Senha"
                IsPassword="True"
                Text="{Binding Aluno.Senha}" />

            <Entry
                Placeholder="Confirmar senha"
                IsPassword="True"
                Text="{Binding ConfirmarSenha}" />

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
                Margin="0,15,0,0">

                <Button
                    Grid.Column="0"
                    Text="Cancelar"
                    Command="{Binding CancelCommand}" />

                <Button
                    Grid.Column="1"
                    Text="Salvar"
                    Command="{Binding SaveAlunoCommand}" />
            </Grid>

            <ActivityIndicator
                IsVisible="{Binding IsBusy}"
                IsRunning="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
