<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ColaboradorListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    x:DataType="vm:ColaboradorListViewModel"
    Title="Colaboradores">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Button
                Text="+ Novo colaborador"
                Command="{Binding AddColaboradorCommand}" />

            <Picker
                Title="Filtrar por"
                TitleColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}"
                ItemsSource="{Binding FilterTypes}"
                SelectedItem="{Binding SelectedFilterType}" />

            <Entry
                Placeholder="Digite sua pesquisa"
                Text="{Binding SearchText}"
                TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}"
                PlaceholderColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />

            <Button
                Text="Pesquisar"
                Command="{Binding SearchColaboradoresCommand}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <CollectionView
                ItemsSource="{Binding Colaboradores}"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="Nenhum colaborador encontrado."
                        TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}"
                        HorizontalOptions="Center"
                        Margin="10" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:ColaboradorDto">

                        <Border
                            Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#555555}"
                            StrokeThickness="1"
                            Padding="12"
                            Margin="0,4">

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="{Binding Nome}"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                                <Label
                                    Text="{Binding Cpf, StringFormat='CPF: {0}'}"
                                    TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                                <Label
                                    Text="{Binding Email, StringFormat='E-mail: {0}'}"
                                    TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                                <Label
                                    Text="{Binding Tipo, StringFormat='Tipo: {0}'}"
                                    TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                                <Label
                                    Text="{Binding Vinculo, StringFormat='Vínculo: {0}'}"
                                    TextColor="{AppThemeBinding Light=#222222, Dark=#FFFFFF}" />

                                <Button
                                    Text="Editar"
                                    Clicked="OnEditButtonClicked" />

                                <Button
                                    Text="Excluir"
                                    BackgroundColor="#0B2A56"
                                    TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteColaboradorCommand}"
                                    CommandParameter="{Binding .}" />

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
