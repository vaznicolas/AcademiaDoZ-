<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
             x:Name="MatriculasPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             x:DataType="vm:MatriculaListViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>

        <converters:FotoToImageSourceConverter
            x:Key="FotoToImageSourceConverter" />

        <converters:EnumDisplayConverter
            x:Key="EnumDisplay" />

        <converters:RestricoesFlagsDisplayConverter
            x:Key="RestricoesDisplay" />

        <DataTemplate x:Key="MatriculaItemTemplate"
                      x:DataType="dto:MatriculaDto">

            <SwipeView>

                <SwipeView.RightItems>
                    <SwipeItems>

                        <SwipeItem Text="Editar"
                                   BackgroundColor="#17365D"
                                   Command="{Binding BindingContext.EditMatriculaCommand, Source={x:Reference MatriculasPage}}"
                                   CommandParameter="{Binding .}" />

                        <SwipeItem Text="Excluir"
                                   BackgroundColor="#C62828"
                                   Command="{Binding BindingContext.DeleteMatriculaCommand, Source={x:Reference MatriculasPage}}"
                                   CommandParameter="{Binding .}" />

                    </SwipeItems>
                </SwipeView.RightItems>

                <Border Style="{StaticResource CardBorder}"
                        Margin="5,6"
                        Padding="12"
                        Stroke="#E0E7EF"
                        StrokeThickness="1"
                        BackgroundColor="White">

                    <Grid ColumnDefinitions="85,*,Auto"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="5">

                        <!-- Foto -->
                        <Border Grid.Column="0"
                                Grid.Row="0"
                                Grid.RowSpan="7"
                                WidthRequest="85"
                                HeightRequest="100"
                                Stroke="#DCE5EF"
                                StrokeThickness="1"
                                BackgroundColor="#F4F7FB"
                                StrokeShape="RoundRectangle 10"
                                VerticalOptions="Center">

                            <Image Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                                   Aspect="AspectFill"
                                   HeightRequest="100"
                                   WidthRequest="85" />

                        </Border>

                        <!-- Nome -->
                        <Label Grid.Column="1"
                               Grid.Row="0"
                               Text="{Binding AlunoMatricula.Nome}"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#17365D"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />

                        <!-- CPF -->
                        <Label Grid.Column="1"
                               Grid.Row="1"
                               Text="{Binding AlunoMatricula.Cpf, StringFormat='CPF: {0}'}"
                               FontSize="12"
                               TextColor="#64748B" />

                        <!-- Matrícula -->
                        <Label Grid.Column="1"
                               Grid.Row="2"
                               Text="{Binding Id, StringFormat='Matrícula: #{0}'}"
                               FontSize="12"
                               TextColor="#64748B" />

                        <!-- Plano -->
                        <Label Grid.Column="1"
                               Grid.Row="3"
                               FontSize="12"
                               TextColor="#334155">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Plano: "
                                          FontAttributes="Bold" />
                                    <Span Text="{Binding Plano, Converter={StaticResource EnumDisplay}}" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <!-- Vigência -->
                        <Label Grid.Column="1"
                               Grid.Row="4"
                               FontSize="12"
                               TextColor="#334155">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Vigência: "
                                          FontAttributes="Bold" />
                                    <Span Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}" />
                                    <Span Text=" até " />
                                    <Span Text="{Binding DataFim, StringFormat='{0:dd/MM/yyyy}'}" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <!-- Restrições -->
                        <Label Grid.Column="1"
                               Grid.Row="5"
                               FontSize="12"
                               TextColor="#334155"
                               LineBreakMode="TailTruncation"
                               MaxLines="2">

                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Restrições: "
                                          FontAttributes="Bold" />
                                    <Span Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}" />
                                </FormattedString>
                            </Label.FormattedText>

                        </Label>

                        <!-- Observações -->
                        <Label Grid.Column="1"
                               Grid.Row="6"
                               Text="{Binding ObservacoesRestricoes, StringFormat='Obs: {0}'}"
                               FontSize="11"
                               TextColor="#64748B"
                               LineBreakMode="TailTruncation"
                               MaxLines="2" />

                        <!-- Menu de ações -->
                        <Button Grid.Column="2"
                                Grid.Row="0"
                                Text=""
                                WidthRequest="36"
                                HeightRequest="36"
                                Padding="0"
                                BackgroundColor="#F1F5F9"
                                TextColor="#17365D"
                                Clicked="OnMoreClicked"
                                CommandParameter="{Binding .}"
                                VerticalOptions="Start"
                                CornerRadius="18">

                            <Button.ImageSource>
                                <FontImageSource FontFamily="MaterialIcons"
                                                 Glyph="&#xe5d4;"
                                                 Size="22"
                                                 Color="#17365D" />
                            </Button.ImageSource>

                        </Button>

                    </Grid>

                </Border>

            </SwipeView>

        </DataTemplate>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="#F5F7FA">

        <!-- Pesquisa e filtros -->
        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}"
                Margin="15,10"
                Padding="10"
                BackgroundColor="White">

            <Grid ColumnDefinitions="Auto,10,*,10,Auto"
                  VerticalOptions="Center">

                <Picker Grid.Column="0"
                        ItemsSource="{Binding FilterTypes}"
                        SelectedItem="{Binding SelectedFilterType}"
                        WidthRequest="110"
                        HorizontalOptions="Start"
                        HeightRequest="40"
                        VerticalOptions="Center"
                        TextColor="#17365D" />

                <Entry Grid.Column="2"
                       Text="{Binding SearchText}"
                       Placeholder="Digite o valor..."
                       HeightRequest="40"
                       VerticalOptions="Center"
                       ClearButtonVisibility="WhileEditing"
                       ReturnCommand="{Binding SearchMatriculasCommand}"
                       TextColor="#17365D"
                       PlaceholderColor="#94A3B8" />

                <!-- Botão Pesquisar -->
                <Button Grid.Column="4"
                        Text="Pesquisar"
                        WidthRequest="105"
                        HeightRequest="40"
                        CornerRadius="8"
                        BackgroundColor="#17365D"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="12"
                        Command="{Binding SearchMatriculasCommand}" />

            </Grid>

        </Border>

        <!-- Lista -->
        <Grid Grid.Row="1">

            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">

                <CollectionView ItemsSource="{Binding Matriculas}"
                                ItemTemplate="{StaticResource MatriculaItemTemplate}"
                                SelectionMode="None"
                                Margin="10">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="1" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>

                        <StackLayout VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Padding="20">

                            <Label Text="Nenhuma matrícula encontrada"
                                   HorizontalOptions="Center"
                                   Style="{StaticResource SubHeadline}"
                                   TextColor="#64748B" />

                            <Button Text="Adicionar Primeira Matrícula"
                                    Command="{Binding AddMatriculaCommand}"
                                    BackgroundColor="#17365D"
                                    TextColor="White"
                                    CornerRadius="10"
                                    HeightRequest="50"
                                    Margin="0,20,0,0" />

                        </StackLayout>

                    </CollectionView.EmptyView>

                </CollectionView>

            </RefreshView>

        </Grid>

        <!-- Nova matrícula -->
        <Button Grid.Row="1"
                Text="Nova matrícula"
                Command="{Binding AddMatriculaCommand}"
                WidthRequest="180"
                HeightRequest="54"
                CornerRadius="10"
                BackgroundColor="#17365D"
                TextColor="White"
                FontAttributes="Bold"
                FontSize="14"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Padding="12,0"
                ZIndex="10">

            <Button.Shadow>
                <Shadow Brush="#000000"
                        Offset="0,4"
                        Radius="8"
                        Opacity="0.20" />
            </Button.Shadow>

            <Button.ImageSource>
                <FontImageSource FontFamily="MaterialIcons"
                                 Glyph="&#xe145;"
                                 Color="White"
                                 Size="22" />
            </Button.ImageSource>

        </Button>

        <!-- Carregamento -->
        <ActivityIndicator Grid.Row="0"
                           Grid.RowSpan="2"
                           IsVisible="{Binding IsBusy}"
                           IsRunning="{Binding IsBusy}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           ZIndex="20" />

    </Grid>

</ContentPage>
