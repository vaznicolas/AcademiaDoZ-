<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
    xmlns:dto="clr-namespace:AcademiaDoZe.Application.DTOs;assembly=AcademiaDoZe.Application"
    xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
    x:Name="MatriculasPage"
    x:DataType="vm:MatriculaListViewModel"
    Title="{Binding Title}"
    BackgroundColor="#F5F3EC">

    <ContentPage.Resources>

        <converters:FotoToImageSourceConverter
            x:Key="FotoToImageSourceConverter" />

        <converters:EnumDisplayConverter
            x:Key="EnumDisplay" />

        <converters:RestricoesFlagsDisplayConverter
            x:Key="RestricoesDisplay" />

        <DataTemplate
            x:Key="MatriculaItemTemplate"
            x:DataType="dto:MatriculaDto">

            <Border
                BackgroundColor="White"
                Stroke="#0B2A6F"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="16"
                Margin="0,0,0,12">

                <Grid
                    ColumnDefinitions="110,*,120"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="16"
                    RowSpacing="7">

                    <!-- FOTO DO ALUNO -->

                    <Border
                        Grid.Column="0"
                        Grid.Row="0"
                        Grid.RowSpan="7"
                        WidthRequest="105"
                        HeightRequest="115"
                        Padding="3"
                        BackgroundColor="#F5F3EC"
                        Stroke="#0B2A6F"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">

                        <Image
                            Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}"
                            Aspect="AspectFill"
                            WidthRequest="99"
                            HeightRequest="109" />

                    </Border>

                    <!-- NOME -->

                    <Label
                        Grid.Column="1"
                        Grid.Row="0"
                        Text="{Binding AlunoMatricula.Nome}"
                        FontFamily="Oswald"
                        FontSize="21"
                        TextColor="#0B2A6F"
                        LineBreakMode="WordWrap" />

                    <!-- CPF -->

                    <Label
                        Grid.Column="1"
                        Grid.Row="1"
                        Text="{Binding AlunoMatricula.Cpf, StringFormat='CPF: {0}'}"
                        FontFamily="Roboto"
                        FontSize="14"
                        TextColor="#5A6478" />

                    <!-- NUMERO DA MATRICULA -->

                    <Label
                        Grid.Column="1"
                        Grid.Row="2"
                        Text="{Binding Id, StringFormat='MATRÍCULA: #{0}'}"
                        FontFamily="Oswald"
                        FontSize="13"
                        TextColor="#0B2A6F" />

                    <!-- PLANO -->

                    <Label
                        Grid.Column="1"
                        Grid.Row="3"
                        FontFamily="Roboto"
                        FontSize="14"
                        TextColor="#5A6478">

                        <Label.FormattedText>
                            <FormattedString>

                                <Span
                                    Text="PLANO: "
                                    FontAttributes="Bold" />

                                <Span
                                    Text="{Binding Plano, Converter={StaticResource EnumDisplay}}" />

                            </FormattedString>
                        </Label.FormattedText>

                    </Label>

                    <!-- VIGENCIA -->

                    <Label
                        Grid.Column="1"
                        Grid.Row="4"
                        FontFamily="Roboto"
                        FontSize="14"
                        TextColor="#5A6478">

                        <Label.FormattedText>
                            <FormattedString>

                                <Span
                                    Text="VIGÊNCIA: "
                                    FontAttributes="Bold" />

                                <Span
                                    Text="{Binding DataInicio, StringFormat='{0:dd/MM/yyyy}'}" />

                                <Span Text=" até " />

                                <Span
                                    Text="{Binding DataFim, StringFormat='{0:dd/MM/yyyy}'}" />

                            </FormattedString>
                        </Label.FormattedText>

                    </Label>

                    <!-- RESTRICOES -->

                    <Label
                        Grid.Column="1"
                        Grid.Row="5"
                        FontFamily="Roboto"
                        FontSize="14"
                        TextColor="#5A6478"
                        LineBreakMode="TailTruncation"
                        MaxLines="2">

                        <Label.FormattedText>
                            <FormattedString>

                                <Span
                                    Text="RESTRIÇÕES: "
                                    FontAttributes="Bold" />

                                <Span
                                    Text="{Binding RestricoesMedicas, Converter={StaticResource RestricoesDisplay}}" />

                            </FormattedString>
                        </Label.FormattedText>

                    </Label>

                    <!-- OBSERVACOES -->

                    <Label
                        Grid.Column="1"
                        Grid.Row="6"
                        Text="{Binding ObservacoesRestricoes, StringFormat='OBSERVAÇÕES: {0}'}"
                        FontFamily="Roboto"
                        FontSize="13"
                        TextColor="#5A6478"
                        LineBreakMode="TailTruncation"
                        MaxLines="2" />

                    <!-- BOTOES DE ACAO -->

                    <VerticalStackLayout
                        Grid.Column="2"
                        Grid.Row="0"
                        Grid.RowSpan="7"
                        Spacing="8"
                        WidthRequest="110"
                        VerticalOptions="Center">

                        <Button
                            Text="EDITAR"
                            Command="{Binding BindingContext.EditMatriculaCommand, Source={x:Reference MatriculasPage}}"
                            CommandParameter="{Binding .}"
                            BackgroundColor="#0B2A6F"
                            TextColor="White"
                            FontFamily="Oswald"
                            FontSize="14"
                            CornerRadius="6"
                            HeightRequest="42" />

                        <Button
                            Text="EXCLUIR"
                            Command="{Binding BindingContext.DeleteMatriculaCommand, Source={x:Reference MatriculasPage}}"
                            CommandParameter="{Binding .}"
                            BackgroundColor="#B3261E"
                            TextColor="White"
                            FontFamily="Oswald"
                            FontSize="14"
                            CornerRadius="6"
                            HeightRequest="42" />

                    </VerticalStackLayout>

                </Grid>

            </Border>

        </DataTemplate>

    </ContentPage.Resources>

    <!-- ESTRUTURA PRINCIPAL -->

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="16">

        <!-- CABECALHO -->

        <Border
            Grid.Row="0"
            BackgroundColor="#071A47"
            Stroke="#0B2A6F"
            StrokeThickness="2"
            StrokeShape="RoundRectangle 8"
            Padding="18">

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="12">

                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="5"
                    VerticalOptions="Center">

                    <Label
                        Text="MATRÍCULAS"
                        FontFamily="Graduate"
                        FontSize="27"
                        TextColor="White" />

                    <Label
                        Text="GERENCIAMENTO DE MATRÍCULAS"
                        FontFamily="Oswald"
                        FontSize="14"
                        CharacterSpacing="2"
                        TextColor="White" />

                </VerticalStackLayout>

                <Button
                    Grid.Column="1"
                    Text="+ NOVA MATRÍCULA"
                    Command="{Binding AddMatriculaCommand}"
                    BackgroundColor="White"
                    TextColor="#0B2A6F"
                    FontFamily="Oswald"
                    FontSize="15"
                    CornerRadius="6"
                    Padding="18,10"
                    VerticalOptions="Center" />

            </Grid>

        </Border>

        <!-- PESQUISA -->

        <Border
            Grid.Row="1"
            BackgroundColor="White"
            Stroke="#0B2A6F"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 8"
            Padding="16">

            <VerticalStackLayout Spacing="10">

                <Label
                    Text="PESQUISAR MATRÍCULAS"
                    FontFamily="Oswald"
                    FontSize="17"
                    TextColor="#0B2A6F" />

                <Grid
                    ColumnDefinitions="180,*,130"
                    ColumnSpacing="10">

                    <Picker
                        Grid.Column="0"
                        Title="Filtrar por"
                        ItemsSource="{Binding FilterTypes}"
                        SelectedItem="{Binding SelectedFilterType}"
                        BackgroundColor="#F5F3EC"
                        TextColor="#071A47"
                        TitleColor="#5A6478"
                        VerticalOptions="Center" />

                    <Entry
                        Grid.Column="1"
                        Placeholder="Digite sua pesquisa"
                        Text="{Binding SearchText}"
                        BackgroundColor="#F5F3EC"
                        TextColor="#071A47"
                        PlaceholderColor="#5A6478"
                        ClearButtonVisibility="WhileEditing"
                        ReturnCommand="{Binding SearchMatriculasCommand}" />

                    <Button
                        Grid.Column="2"
                        Text="PESQUISAR"
                        Command="{Binding SearchMatriculasCommand}"
                        Style="{StaticResource OldSchoolPrimaryButton}"
                        HeightRequest="48"
                        VerticalOptions="Center" />

                </Grid>

            </VerticalStackLayout>

        </Border>

        <!-- LISTA DE MATRICULAS -->

        <RefreshView
            Grid.Row="2"
            IsRefreshing="{Binding IsRefreshing}"
            Command="{Binding RefreshCommand}">

            <CollectionView
                ItemsSource="{Binding Matriculas}"
                ItemTemplate="{StaticResource MatriculaItemTemplate}"
                SelectionMode="None"
                VerticalOptions="FillAndExpand">

                <CollectionView.ItemsLayout>

                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="1" />

                </CollectionView.ItemsLayout>

                <CollectionView.EmptyView>

                    <VerticalStackLayout
                        Padding="30"
                        Spacing="12"
                        HorizontalOptions="Center">

                        <Label
                            Text="Nenhuma matrícula encontrada."
                            FontFamily="Oswald"
                            FontSize="18"
                            TextColor="#5A6478"
                            HorizontalTextAlignment="Center" />

                        <Button
                            Text="+ ADICIONAR PRIMEIRA MATRÍCULA"
                            Command="{Binding AddMatriculaCommand}"
                            Style="{StaticResource OldSchoolPrimaryButton}"
                            HeightRequest="48" />

                    </VerticalStackLayout>

                </CollectionView.EmptyView>

            </CollectionView>

        </RefreshView>

        <!-- CARREGAMENTO -->

        <ActivityIndicator
            Grid.Row="0"
            Grid.RowSpan="3"
            IsVisible="{Binding IsBusy}"
            IsRunning="{Binding IsBusy}"
            Color="#0B2A6F"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            ZIndex="20" />

    </Grid>

</ContentPage>
